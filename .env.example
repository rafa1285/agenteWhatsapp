# Entorno de ejecución: development | production
ENV=development

# PostgreSQL (motor de reservas, multi-tenant) — formato SQLAlchemy async
DATABASE_URL=postgresql+asyncpg://usuario:password@localhost:5432/agente_whatsapp

# Redis (caché / estado de conversación y broker del worker de recordatorios:
# Celery la reutiliza como broker y result backend)
REDIS_URL=redis://localhost:6379/0

# Worker de recordatorios (Celery + Redis beat). Intervalo del beat, reintentos
# máximos por recordatorio (1 envío + reintentos), retardo entre reintentos y
# tamaño de lote por tick.
REMINDER_TICK_INTERVAL_SECONDS=300
REMINDER_MAX_ATTEMPTS=3
REMINDER_RETRY_DELAY_SECONDS=300
REMINDER_BATCH_SIZE=50

# API key de Anthropic (Claude Haiku 4.5). Vacía por defecto; rellenar solo en `.env` (no versionado).
ANTHROPIC_API_KEY=
# Modelo y parámetros por defecto del agente (configurables por entorno).
# Prefijo AGENT_ para no chocar con variables de entorno que define Claude Code
# (p. ej. ANTHROPIC_MODEL).
AGENT_MODEL=claude-haiku-4-5-20251001
AGENT_MAX_TOKENS=1024
AGENT_TEMPERATURE=0.3

# Canal WhatsApp (360dialog). Token API secreto (solo en `.env`); verify token
# del handshake del webhook (fijar un valor real en producción).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=cambia-me
WHATSAPP_API_URL=https://waba.360dialog.io/v1/messages
WHATSAPP_API_TOKEN=
WHATSAPP_API_TIMEOUT=10.0

# Canal de voz (Twilio TwiML webhook). Base pública de los webhooks: túnel local
# (ngrok/cloudflared) en desarrollo o el dominio en producción. Twilio exige URLs
# absolutas en los `action` de Gather/Dial.
VOICE_BASE_URL=
# Credenciales de la cuenta Twilio para validar la firma de los webhooks
# (`X-Twilio-Signature`) y para futuras integraciones con la API de Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURE=true
# Confianza mínima del STT de Twilio para aceptar el turno (0-1); por debajo se pide repetición.
VOICE_STT_CONFIDENCE_THRESHOLD=0.5
# Silencios: 1º re-pregunta (~4s), 2º cuelga y registra la llamada incompleta (~8s).
VOICE_SILENCE_REPROMPT_SECONDS=4
VOICE_SILENCE_HANGUP_SECONDS=8
# Segundos que Twilio intenta la transferencia en vivo antes de colgar.
VOICE_TRANSFER_DIAL_TIMEOUT=15

# JWT Auth (panel → backend). Clave pública PEM para validar RS256.
# En dev: archivo local (storage/keys/public.pem); en prod: secret manager / volume montado.
# Generar par RSA: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PUBLIC_KEY_PATH=storage/keys/public.pem
JWT_ISSUER=reception-panel
JWT_AUDIENCE=reception-api
JWT_ALGORITHM=RS256
